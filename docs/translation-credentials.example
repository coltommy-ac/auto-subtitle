# Optional translation credentials for auto-subtitle.
#
# Copy only the provider block you use to ~/.autosub_credentials, then restrict
# that file to its owner, for example: chmod 600 ~/.autosub_credentials
# Do not put this file, a populated copy, .env files, or keys into Git.
#
# The project reads ~/.autosub_credentials first, then environment variables.
# Run `bin/doctor --engine deepl` or `bin/doctor --engine baidu` to verify that
# the required names are configured; it never prints their values.

# DeepL
# Create an API key in the DeepL account that owns the intended usage and
# billing/quota. The key needs permission to use the translation API.
DEEPL_APIKEY=replace_with_your_deepl_api_key

# Baidu Translate
# Create an application in the Baidu Translate console and use credentials
# authorized for the translation API and its applicable quota/billing plan.
BAIDU_APPID=replace_with_your_baidu_app_id
BAIDU_APPKEY=replace_with_your_baidu_app_key
